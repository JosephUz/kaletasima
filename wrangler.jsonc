{
  // Kale Taşıma istemcisi — Cloudflare Worker, yalnız statik dosyalar (kod yok): kaletasima.josephuz.com.
  // Dosyalar `npm run build:web` ile dist/ klasörüne toplanır; yayın: `npm run deploy:web`.
  // Çevrim içi oyun sunucusu ayrı: evdeki PC'de Docker + Cloudflare Tunnel → kaletasima-sunucu.josephuz.com (src/config.js → SERVER).
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "kaletasima",
  "compatibility_date": "2026-09-01",
  "workers_dev": false,
  "assets": { "directory": "./dist" },
  // custom_domain: DNS kaydını wrangler açar; bu adda başka kayıt (tunnel route, CNAME) kalmamalı.
  "routes": [{ "pattern": "kaletasima.josephuz.com", "custom_domain": true }]
}
